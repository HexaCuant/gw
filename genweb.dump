SET statement_timeout = 0;
SET client_encoding = 'UTF8';
SET standard_conforming_strings = off;
SET check_function_bodies = false;
SET client_min_messages = warning;
SET escape_string_warning = off;

SET search_path = public, pg_catalog;

--
-- Name: user_id; Type: SEQUENCE; Schema: public; Owner: genweb
--

CREATE SEQUENCE user_id
    START WITH 1
    INCREMENT BY 1
    NO MAXVALUE
    NO MINVALUE
    CACHE 1;


ALTER TABLE public.user_id OWNER TO genweb;

--
-- Name: user_id; Type: SEQUENCE SET; Schema: public; Owner: genweb
--

SELECT pg_catalog.setval('user_id', 5, true);


SET default_tablespace = '';

SET default_with_oids = false;

--
-- Name: users; Type: TABLE; Schema: public; Owner: genweb; Tablespace: 
--

CREATE TABLE users (
    id integer DEFAULT nextval('user_id'::regclass),
    cod_auth integer,
    username character varying(20),
    pass character varying(20)
);


ALTER TABLE public.users OWNER TO genweb;

--
-- Data for Name: users; Type: TABLE DATA; Schema: public; Owner: genweb
--

COPY users (id, cod_auth, username, pass) FROM stdin;
